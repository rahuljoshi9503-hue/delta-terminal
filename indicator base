                # 2. EXITS
                elif current_position == 1:
                    if direction > 0 or close <= st or gamma_risk:
                        reason = "Gamma Exit" if gamma_risk else "PE StopLoss Hit"
                        print(f"⚠️ [EXIT SIGNAL] Bullish Trade Closed ({reason})")
