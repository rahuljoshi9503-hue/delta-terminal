                elif current_position == -1:
                    if direction < 0 or close >= st or gamma_risk:
                        reason = "Gamma Exit" if gamma_risk else "CE StopLoss Hit"
                        print(f"⚠️ [EXIT SIGNAL] Bearish Trade Closed ({reason})")
                        current_position = 0

            time.sleep(15)

        except Exception as e:
            print(f"लूप एरर: {e}")
            time.sleep(10)

